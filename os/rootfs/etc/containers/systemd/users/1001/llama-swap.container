[Unit]
Description=Sibyl llama-swap (llama.cpp inference)
Wants=network-online.target
After=network-online.target
# sibyl-diag sets this flag after a boot loop. Clear it with `sibyl-diag safe-mode off`.
ConditionPathExists=!/var/lib/sibyl/config/safe-mode

[Container]
ContainerName=llama-swap
# The backend drop-in (llama-swap.container.d/backend.conf) sets Image=.
Network=sibyl.network
# Host loopback only, for the sibyl-diag watchdog and metrics sampler.
# nftables never forwards to it, and Caddy stays the only remote entry point.
PublishPort=127.0.0.1:18080:8080
AddDevice=/dev/kfd
AddDevice=/dev/dri
GroupAdd=keep-groups
UserNS=keep-id:uid=10001,gid=10001
Volume=/var/lib/sibyl/models:/models:ro,z
Volume=/var/lib/sibyl/config/llama-swap.yaml:/app/config.yaml:ro,z
DropCapability=ALL
NoNewPrivileges=true
ReadOnly=true
Tmpfs=/tmp:rw,size=1g,mode=1777
ShmSize=8g
Ulimit=memlock=-1:-1
PidsLimit=4096
HealthCmd=["curl","-fsS","http://127.0.0.1:8080/health"]
HealthInterval=30s
HealthStartPeriod=20s
HealthRetries=3
# A failed health check kills the container, and Restart=always brings it back.
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
